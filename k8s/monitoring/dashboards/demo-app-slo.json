      "description": "Multi-window burn rates used by the alerts. Page when the 1h AND 5m windows exceed 14.4x (or 6h AND 30m exceed 6x)."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Pod CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"demo\",container=\"demo-app\"}[2m]))",
