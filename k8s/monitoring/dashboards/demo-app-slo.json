      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "From kube-state-metrics."
    },
    {
      "id": 14,
      "type": "timeseries",
